{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aix.evidence-index/v1",
  "title": "AIXSILICON Evidence Index",
  "description": "一次运行（Run）的结构化判定证据索引，用于结论可重建。",
  "type": "object",
  "required": ["schema_version", "run_id", "workspace_lock", "stages", "gates", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "aix.evidence-index/v1" },
    "run_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "trigger": {
      "type": "string",
      "enum": ["cli", "ci", "nightly", "manual", "skill"]
    },
    "flow": { "type": "string" },
    "flow_version": { "type": "string" },
    "workspace_lock": { "type": "string", "description": "引用 resolved lock 文件路径" },
    "manifest_digest": { "type": "string" },
    "random_seed": { "type": "string" },
    "stages": {
      "type": "object",
      "description": "key 为 stage id。",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["status", "started_at", "finished_at"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["passed", "failed", "skipped", "blocked"] },
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "exit_code": { "type": "integer" },
            "tool": { "type": "string" },
            "log": { "type": "string" },
            "failure_signature": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "description": "key 为 gate id（G0..G7 或自定义）。",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9_-]*$": {
          "type": "object",
          "required": ["result"],
          "additionalProperties": false,
          "properties": {
            "result": { "type": "string", "enum": ["pass", "fail", "blocked", "not_run"] },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "storage_ref": { "type": "string" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["who", "when", "action"],
        "additionalProperties": false,
        "properties": {
          "who": { "type": "string" },
          "when": { "type": "string", "format": "date-time" },
          "action": { "type": "string" }
        }
      }
    }
  }
}
