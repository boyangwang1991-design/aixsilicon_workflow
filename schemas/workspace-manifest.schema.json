{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aix.workspace/v1",
  "title": "AIXSILICON Workspace Manifest",
  "description": "描述期望工作区：需要克隆哪些 Git 仓库、放在哪里、使用何种开发分支或版本策略。不记录本地瞬时状态。",
  "type": "object",
  "required": ["schema_version", "workspace", "remotes", "repositories", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "aix.workspace/v1",
      "description": "必须锁定为 aix.workspace/v1，保证解析器版本兼容。"
    },
    "extends": {
      "type": "string",
      "description": "可选的基 Manifest 相对路径。子 Manifest 只声明差异，解析器会深合并。"
    },
    "workspace": {
      "type": "object",
      "required": ["name", "default_profile", "repos_root", "generated_root"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "default_profile": { "type": "string" },
        "repos_root": { "type": "string", "default": "repos" },
        "generated_root": { "type": "string", "default": ".aix/generated" },
        "lock_root": { "type": "string", "default": ".aix" }
      }
    },
    "remotes": {
      "type": "object",
      "description": "批准 remote 的 allowlist。key 为 remote 名。",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["base_url"],
          "additionalProperties": false,
          "properties": {
            "base_url": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/definitions/repository" }
    },
    "profiles": {
      "type": "object",
      "description": "Profile -> 启用的 groups 列表。",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["include_groups"],
          "additionalProperties": false,
          "properties": {
            "include_groups": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "repository": {
      "type": "object",
      "required": ["id", "type", "path", "remote", "repo", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "description": "组织内稳定的逻辑仓库 ID" },
        "type": {
          "type": "string",
          "enum": [
            "hw-interface", "cbb", "ip", "dv-common", "vip", "tool",
            "catalog", "soc-integration", "skill", "techlib", "model",
            "sw", "reference-soc", "chip-soc", "overlay", "other"
          ]
        },
        "path": {
          "type": "string",
          "description": "相对路径，必须位于 workspace.repos_root 之下，禁止绝对路径和 .. 逃逸。"
        },
        "remote": { "type": "string", "description": "引用 remotes 中已批准的 remote 名" },
        "repo": { "type": "string", "description": "remote base_url 下的仓库名（可含 .git）" },
        "revision": { "$ref": "#/definitions/revision" },
        "groups": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "required": { "type": "boolean", "default": true },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "default": "public"
        },
        "owner": { "type": "string", "description": "负责该仓的团队/平台" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "仓库级依赖 ID，必须形成有向无环图",
          "default": []
        },
        "fusesoc_roots": {
          "type": "array",
          "items": { "type": "string" },
          "description": "该仓中作为 FuseSoC core root 的目录",
          "default": []
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "该仓对外暴露的能力标识，如 interface-contracts、fusesoc-cores",
          "default": []
        },
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shallow": { "type": "boolean", "default": false },
            "lfs": { "type": "boolean", "default": false },
            "sparse_paths": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "description": "至少提供一种解析方式；正式基线必须由 Lockfile 固定 SHA。",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["branch"] },
        { "required": ["tag"] },
        { "required": ["commit"] },
        { "required": ["range"] }
      ],
      "properties": {
        "branch": { "type": "string" },
        "tag": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 },
        "range": { "type": "string", "description": "如 main..feature/x" }
      }
    }
  }
}
