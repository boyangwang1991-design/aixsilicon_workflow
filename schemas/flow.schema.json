{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aix.flow/v1",
  "title": "AIXSILICON Flow Definition",
  "description": "跨仓流程 DAG：输入、前置条件、Stage 依赖、Gate 与证据出口。",
  "type": "object",
  "required": ["schema_version", "name", "stages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "aix.flow/v1" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clean_workspace": { "type": "boolean", "default": false },
        "lock_required": { "type": "boolean", "default": false },
        "forbid_local_override": { "type": "boolean", "default": false },
        "required_gates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/definitions/stage" }
    },
    "on_failure": {
      "type": "string",
      "enum": ["fail_fast", "collect_evidence_then_fail"],
      "default": "collect_evidence_then_fail"
    },
    "gates": {
      "type": "array",
      "description": "Flow 级质量 Gate（G0..G7 或自定义），Evidence 阶段汇总判定。",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "required": ["id", "uses"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "needs": { "type": "array", "items": { "type": "string" } },
        "uses": { "type": "string", "description": "注册过的 Action 名，禁止任意 Shell 字符串" },
        "with": { "type": "object" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0, "default": 0 },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "paths"],
            "properties": {
              "repo": { "type": "string" },
              "paths": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "gates": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
