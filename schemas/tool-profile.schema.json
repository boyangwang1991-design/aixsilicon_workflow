{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aix.tool-profile/v1",
  "title": "AIXSILICON Tool Profile",
  "description": "工具链与环境 Profile：OS、Python、开源/商业 EDA 工具版本与所需环境变量。",
  "type": "object",
  "required": ["schema_version", "name", "host", "python"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "aix.tool-profile/v1" },
    "name": { "type": "string" },
    "host": {
      "type": "object",
      "required": ["os"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "enum": ["linux", "darwin", "windows"] },
        "arch": { "type": "string" }
      }
    },
    "python": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" }
      }
    },
    "tools": {
      "type": "object",
      "description": "key 为工具名；value 为版本约束字符串或对象。",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["version"],
            "additionalProperties": false,
            "properties": {
              "version": { "type": "string" },
              "enabled": { "type": "boolean", "default": true },
              "path": { "type": "string" }
            }
          }
        ]
      }
    },
    "commercial": {
      "type": "object",
      "description": "商业 EDA 工具（不保存许可证或内部路径，仅记录是否启用与版本策略）。",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled"],
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "version": { "type": "string" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_variables": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
